# Docker does NOT read .gitignore. Anything not listed here is copied into
# the image and shipped to whatever registry the deploy pushes to, so every
# secret has to be named twice -- once in .gitignore and once here.
#
# This file previously omitted data/session_state.json and
# data/browser_profile/, which hold a live authenticated Yale CAS/Duo
# session. A deploy would have published them.

# --- the whole personal data directory ------------------------------------
# Excluded wholesale rather than file by file. It holds the saved Yale
# session, the browser profile, the dashboard password, AND events.db --
# which contains members-only club events that are only visible because
# somebody signed in. The image gets demo/snapshot.json.gz instead, which
# is built from a public-only ingest.
data/

# --- credentials, wherever else they turn up ------------------------------
.env
.env.*
!.env.example
*.pem
*.key
# The NetID PDF, if it is ever copied into the tree by mistake.
*.pdf

# --- local tooling --------------------------------------------------------
.venv
.tools
.git
.gitignore
.github
.claude
.agents
.pytest_cache
__pycache__
*.pyc
*.pyo
.DS_Store

# --- build output and scratch --------------------------------------------
output/
frontend/node_modules
frontend/dist
node_modules

# --- not needed at runtime ------------------------------------------------
tests/
scripts/
*.md
!prompts/*.md
