# Copy to .env and fill in. Never commit .env.
# Loaded by python-dotenv from the project root and one level up.

# --- Agent (Ask) ---
# Required only to run the pydantic-ai agent. The public site does not need
# it: without a key, Ask falls back to the free local search.
OPENAI_API_KEY=
# Optional. Point at a gateway or class-provided endpoint instead of OpenAI.
OPENAI_BASE_URL=
# Optional. Model name passed to OpenAIResponsesModel.
YALENDAR_MODEL=gpt-5
# Set to 1 to let any visitor use the agent. Leave unset: on a public URL
# this bills every stranger's question to you.
YALENDAR_PUBLIC_AGENT=

# --- Existing app ---
# Shared password (legacy; access is currently open).
YALE_TODAY_PASSWORD=
# Session signing secret for deployment.
SESSION_SECRET=
# Set to 1 behind HTTPS so session cookies are secure-only.
YALE_TODAY_HTTPS=
# Path to the local NetID PDF. Never commit that file.
YALE_NETID_PDF=/Users/rias/Downloads/Yale Calendar/Yale Net ID Info.pdf
